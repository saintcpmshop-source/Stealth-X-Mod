# ═══════════════════════════════════════════════════════════
#  Stealth X — Git Attributes
# ═══════════════════════════════════════════════════════════

# Default text behavior
* text=auto eol=lf

# Explicit text files
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.properties text eol=lf
*.gradle  text eol=lf
*.java    text eol=lf
*.kt      text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Windows scripts
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files
*.apk     binary
*.aab     binary
*.apks    binary
*.xapk    binary
*.obb     binary
*.jar     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.ttf     binary
*.otf     binary
*.mp3     binary
*.mp4     binary
*.zip     binary
*.7z      binary

# GitHub linguist
*.md      linguist-documentation
docs/*    linguist-documentation
LICENSE   linguist-documentation
